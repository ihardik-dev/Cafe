datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// USER & ACCESS CONTROL
// ----------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CUSTOMER)
  refreshToken String?
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
}

// ----------------------------------------------------
// MENU & INVENTORY
// ----------------------------------------------------

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id             String          @id @default(uuid())
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceInPaise   Int             // Stored as integer paise (e.g. ₹240.00 = 24000 paise)
  imageUrl       String?
  isAvailable    Boolean         @default(true)
  isPerishable   Boolean         @default(false)
  inventory      InventoryItem?
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
}

model ModifierGroup {
  id           String           @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String           // e.g. "Milk Choice", "Extra Shots", "Syrups"
  minSelection Int              @default(0)
  maxSelection Int              @default(1)
  options      ModifierOption[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([menuItemId])
}

model ModifierOption {
  id                 String              @id @default(uuid())
  groupId            String
  group              ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name               String              // e.g. "Oat Milk", "Extra Espresso Shot", "Hazelnut Syrup"
  extraPriceInPaise  Int                 @default(0) // Integer paise (e.g. ₹60.00 = 6000 paise)
  isAvailable        Boolean             @default(true)
  orderItemModifiers OrderItemModifier[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([groupId])
}

model InventoryItem {
  id                String   @id @default(uuid())
  menuItemId        String   @unique
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@index([stockQuantity])
}

// ----------------------------------------------------
// ORDERS & FINANCIAL AUDIT (INDIAN RUPEES / PAISE)
// ----------------------------------------------------

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED_LATE_WEBHOOK
  REFUNDED
}

model Order {
  id               String               @id @default(uuid())
  orderNumber      String               @unique // Human-readable e.g. CAFE-20261107-001
  userId           String?
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           OrderStatus          @default(PENDING_PAYMENT)
  subtotalInPaise  Int                  // Base items sum in paise
  taxInPaise       Int                  // Standard GST calculated server-side in paise
  totalInPaise     Int                  // Final bill in paise
  idempotencyKey           String?              @unique // Prevents double checkout submissions
  idempotencyPayloadHash   String?              // SHA-256 fingerprint of cart items & amount
  guestAccessTokenHash     String?              // SHA-256 hash of secret guest token (prevents IDOR access)
  paymentIntentId          String?              @unique // Gateway Order ID (e.g. order_xxxx)
  paymentId                String?              @unique // Gateway Payment ID (e.g. pay_xxxx)
  paymentMethod    String?              // e.g. "UPI", "CARD", "NETBANKING", "CASH"
  customerNote     String?
  customerEmail    String?
  customerPhone    String?
  expiresAt        DateTime             // Unpaid orders auto-cancel after 15 mins
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  refundAudits     RefundAudit[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model OrderItem {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem            @relation(fields: [menuItemId], references: [id])
  name              String              // Snapshot of item name at checkout (immutable receipt)
  quantity          Int
  unitPriceInPaise  Int                 // Snapshot of base price at checkout in paise
  totalPriceInPaise Int                 // (unitPrice + modifiers) * quantity in paise
  modifiers         OrderItemModifier[]
  createdAt         DateTime            @default(now())

  @@index([orderId])
}

model OrderItemModifier {
  id                 String         @id @default(uuid())
  orderItemId        String
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId   String
  modifierOption     ModifierOption @relation(fields: [modifierOptionId], references: [id])
  name               String         // Snapshot name
  extraPriceInPaise  Int            // Snapshot extra price in paise
  createdAt          DateTime       @default(now())

  @@index([orderItemId])
}

model OrderStatusHistory {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus OrderStatus
  toStatus   OrderStatus
  changedBy  String?     // User ID or "SYSTEM"
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

// ----------------------------------------------------
// TABLE RESERVATIONS & CONCURRENCY DEFENSE
// ----------------------------------------------------

enum TableArea {
  INDOOR
  OUTDOOR
  PATIO
  BAR_COUNTER
}

enum ReservationStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Table {
  id           String            @id @default(uuid())
  tableNumber  Int               @unique
  capacity     Int
  area         TableArea         @default(INDOOR)
  isActive     Boolean           @default(true)
  reservations Reservation[]
  holds        ReservationHold[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([capacity])
}

model Reservation {
  id            String            @id @default(uuid())
  tableId       String
  table         Table             @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone        String
  guestAccessTokenHash String?           // SHA-256 hash of secret guest token (prevents unauthorized cancellation)
  guestCount           Int
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(CONFIRMED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tableId, startTime, endTime])
  @@index([status])
}

// Temporary 10-minute hold to guarantee zero double-bookings during checkout
model ReservationHold {
  id            String   @id @default(uuid())
  tableId       String
  table         Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  slotStartTime DateTime
  slotEndTime   DateTime
  heldByToken   String   @unique
  guestCount    Int      @default(2) // Party size locked at hold time
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  // Database-level uniqueness guarantees that two clients cannot hold the same table & start time simultaneously
  @@unique([tableId, slotStartTime])
  @@index([expiresAt])
}

// ----------------------------------------------------
// PAYMENT WEBHOOK IDEMPOTENCY & REFUND AUDIT (INR)
// ----------------------------------------------------

model InboundWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // Gateway event ID (e.g. evt_123456789 or pay_123456789)
  eventType   String   // e.g. "payment.captured", "payment_intent.succeeded"
  payloadJson String   // Raw JSON string
  processedAt DateTime @default(now())

  @@index([eventId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model RefundAudit {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntentId String
  amountInPaise   Int          // Amount in paise
  reason          String       // e.g. "LATE_WEBHOOK_RECEIVED_AFTER_EXPIRATION"
  gatewayRefundId String?
  status          RefundStatus @default(PENDING)
  createdAt       DateTime     @default(now())

  @@index([orderId])
}
