# Server Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/cafe_db?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="super-secret-cafe-jwt-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="super-secret-cafe-jwt-refresh-key-minimum-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway Webhook Secret
WEBHOOK_SECRET="whsec_test_cafe_secret_key_12345"

# Frontend Origin (CORS)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
